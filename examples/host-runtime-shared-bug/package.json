{
  "name": "examples-host-runtime-shared-bug",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter examples-host-runtime-shared-bug-remote run dev\" \"pnpm --filter examples-host-runtime-shared-bug-host run dev\"",
    "dev:remote": "pnpm --filter examples-host-runtime-shared-bug-remote run dev",
    "dev:host": "pnpm --filter examples-host-runtime-shared-bug-host run dev",
